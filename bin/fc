#!/usr/bin/env bash
# fc = fix claude. Points ~/.local/bin/claude at the newest Claude Code build
# that actually runs: some releases segfault on this glibc, so every candidate
# is smoke-tested with --version before the symlink moves. Safe to re-run.
set -euo pipefail

VERSIONS_DIR="$HOME/.local/share/claude/versions"
LINK="$HOME/.local/bin/claude"
BROKEN_LIST="$HOME/.local/share/claude/broken-versions"
SMOKE_TIMEOUT=20

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'

if [ ! -d "$VERSIONS_DIR" ]; then
    echo "fc: no versions dir at $VERSIONS_DIR" >&2
    exit 1
fi

current=""
[ -L "$LINK" ] && current="$(basename "$(readlink -f "$LINK")")"

# Newest first, natural version order.
mapfile -t candidates < <(find "$VERSIONS_DIR" -maxdepth 1 -type f -printf '%f\n' | sort -Vr)

picked=""
for version in "${candidates[@]}"; do
    binary="$VERSIONS_DIR/$version"

    if [ ! -s "$binary" ]; then
        echo -e "${YELLOW}skip${NC}  $version (empty — partial download)"
        continue
    fi
    if [ ! -x "$binary" ]; then
        echo -e "${YELLOW}skip${NC}  $version (not executable)"
        continue
    fi
    if grep -qxF "$version" "$BROKEN_LIST" 2>/dev/null; then
        echo -e "${YELLOW}skip${NC}  $version (known broken)"
        continue
    fi

    # Nested bash so the "Segmentation fault" notice lands on its stderr, not ours.
    if bash -c 'timeout "$1" "$2" --version; exit $?' _ "$SMOKE_TIMEOUT" "$binary" >/dev/null 2>&1; then
        picked="$version"
        break
    fi

    echo -e "${RED}fail${NC}  $version (--version crashed)"
    echo "$version" >> "$BROKEN_LIST"
done

if [ -z "$picked" ]; then
    echo -e "${RED}fc: no working version found${NC}" >&2
    exit 1
fi

if [ "$picked" = "$current" ]; then
    echo -e "${GREEN}ok${NC}    claude already pinned to $picked"
    exit 0
fi

ln -sfn "$VERSIONS_DIR/$picked" "$LINK"
echo -e "${GREEN}ok${NC}    claude pinned to $picked (was ${current:-unset})"
