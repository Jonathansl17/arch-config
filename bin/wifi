#!/bin/bash

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=wifi-mac.sh
source "$SCRIPT_DIR/wifi-mac.sh"
# shellcheck source=wifi-profile.sh
source "$SCRIPT_DIR/wifi-profile.sh"
# shellcheck source=wifi-saved.sh
source "$SCRIPT_DIR/wifi-saved.sh"
# shellcheck source=wifi-edit.sh
source "$SCRIPT_DIR/wifi-edit.sh"

# Detect the WiFi interface dynamically (avoids hardcoding wlp4s0/wlan0/etc).
WIFI_IFACE=$(nmcli -t -f DEVICE,TYPE device | awk -F: '$2 == "wifi" {print $1; exit}')
if [[ -z "$WIFI_IFACE" ]]; then
  echo -e "${RED}No WiFi interface detected on this machine.${NC}"
  exit 1
fi

# read_input "prompt" [silent]
# REPLY=text. Returns 2 if user typed q/Q (back).
read_input() {
  local prompt="$1" silent="$2"
  if [[ -n "$silent" ]]; then
    read -rsp "$prompt" REPLY
    echo ""
  else
    read -rp "$prompt" REPLY
  fi
  [[ "$REPLY" == "q" || "$REPLY" == "Q" ]] && return 2
  return 0
}

show_status() {
  local eth_conn wifi_conn
  eth_conn=$(nmcli -t -f NAME,TYPE connection show --active | awk -F: '$2 ~ /ethernet/ {print $1; exit}')
  wifi_conn=$(nmcli -t -f NAME,TYPE connection show --active | awk -F: '$2 ~ /wireless/ {print $1; exit}')
  echo -e "${CYAN}=== WiFi Manager ===${NC}"
  echo ""
  if [[ -n "$eth_conn" ]]; then
    echo -e "  LAN:  ${GREEN}Connected${NC} → ${GREEN}$eth_conn${NC}"
  else
    echo -e "  LAN:  ${YELLOW}Disconnected${NC}"
  fi
  if [[ -n "$wifi_conn" ]]; then
    echo -e "  WiFi: ${GREEN}Connected${NC} → ${GREEN}$wifi_conn${NC}"
  else
    echo -e "  WiFi: ${YELLOW}Disconnected${NC}"
  fi
}

invalid() { echo -e "${RED}Invalid selection. Try again (q to go back).${NC}"; }

# Exact-name matchers. nmcli -t output is field-separated by ':', so a plain
# grep regex breaks on SSIDs containing regex metacharacters. awk compares the
# whole field instead.
is_active_connection() {
  nmcli -t -f NAME,TYPE connection show --active \
    | awk -F: -v n="$1" '$1 == n && $2 ~ /wireless/ {found = 1} END {exit !found}'
}

is_saved_connection() {
  nmcli -t -f NAME,TYPE connection show \
    | awk -F: -v n="$1" '$1 == n && $2 ~ /wireless/ {found = 1} END {exit !found}'
}

# verify_activation <connection-name> <nmcli-exit-code>
# A non-zero nmcli exit is NOT proof of failure: NetworkManager keeps retrying
# in the background (autoconnect), and 802.1X associations routinely time out on
# the first attempt while succeeding seconds later. Poll the real device state
# before declaring failure.
verify_activation() {
  local name="$1" rc="$2" waited=0 timeout=45 state

  if [[ "$rc" -eq 0 ]]; then
    echo -e "${GREEN}Connected to $name successfully!${NC}"
    return 0
  fi

  echo -e "${YELLOW}nmcli reported a failure. Waiting up to ${timeout}s in case NetworkManager retries...${NC}"
  while (( waited < timeout )); do
    if is_active_connection "$name"; then
      echo ""
      echo -e "${GREEN}Connected to $name successfully (NetworkManager retried in background).${NC}"
      return 0
    fi
    printf "."
    sleep 2
    waited=$((waited + 2))
  done

  echo ""
  state=$(nmcli -t -f GENERAL.STATE device show "$WIFI_IFACE" 2>/dev/null | cut -d: -f2-)
  echo -e "${RED}Failed to connect to $name.${NC}"
  echo -e "${RED}Device $WIFI_IFACE state: ${state:-unknown}${NC}"
  return 1
}

connect_new() {
  local networks=() ssid signal security net_choice sec_choice
  while true; do
    echo ""
    echo -e "${YELLOW}Scanning available networks...${NC}"
    nmcli device wifi rescan >/dev/null 2>&1
    mapfile -t networks < <(nmcli -t -f SSID,SIGNAL,SECURITY device wifi list | grep -v '^:' | sort -t: -k2 -rn | awk -F: '!seen[$1]++')

    if [[ ${#networks[@]} -eq 0 ]]; then
      echo -e "${RED}No networks found.${NC}"
      return 0
    fi

    echo ""
    echo -e "${CYAN}Available networks:${NC}"
    echo ""
    for i in "${!networks[@]}"; do
      IFS=: read -r ssid signal security <<< "${networks[$i]}"
      printf "  %d) %-30s Signal: %s%%  Security: %s\n" $((i+1)) "$ssid" "$signal" "${security:-Open}"
    done

    echo ""
    while true; do
      read_input "Select a network [1-${#networks[@]}, 0=rescan, q=back]: " || return 2
      net_choice="$REPLY"
      if [[ "$net_choice" == "0" ]]; then
        clear
        break
      fi
      if [[ "$net_choice" =~ ^[0-9]+$ ]] && (( net_choice >= 1 && net_choice <= ${#networks[@]} )); then
        break 2
      fi
      invalid
    done
  done

  IFS=: read -r ssid signal security <<< "${networks[$((net_choice-1))]}"

  echo ""
  echo -e "Selected: ${GREEN}$ssid${NC} (${security:-Open})"

  if is_saved_connection "$ssid"; then
    echo -e "${YELLOW}Saved connection found. Connecting...${NC}"
    nmcli connection up "$ssid"
    verify_activation "$ssid" $?
    return 0
  fi

  while true; do
    echo ""
    echo "  1) Open (no password)"
    echo "  2) WPA/WPA2 Personal (password only)"
    echo "  3) WPA2 Enterprise (user + password)"
    echo ""
    read_input "Select security type [1/2/3, q=back]: " || return 2
    sec_choice="$REPLY"
    case "$sec_choice" in
      1|2|3) break ;;
      *) invalid ;;
    esac
  done

  prompt_security_args "$sec_choice" "$security" || return 2
  choose_mac_mode || return 2

  if ! add_profile "$ssid" "${SEC_ARGS[@]}" "$MAC_MODE_PROPERTY" "$MAC_MODE"; then
    echo -e "${RED}Failed to create the profile for $ssid.${NC}"
    return 1
  fi
  nmcli connection up "$ssid"
  verify_activation "$ssid" $?
}

reconnect_saved() {
  choose_saved_connection "Select a connection" || return $?
  echo -e "${YELLOW}Connecting to $CHOSEN...${NC}"
  nmcli connection up "$CHOSEN"
  verify_activation "$CHOSEN" $?
}

disconnect_current() {
  local active
  echo ""
  active=$(nmcli -t -f NAME,TYPE connection show --active | awk -F: '$2 ~ /wireless/ {print $1; exit}')
  if [[ -z "$active" ]]; then
    echo -e "${YELLOW}No WiFi network currently connected.${NC}"
    return 0
  fi
  echo -e "${YELLOW}Disconnecting from $active...${NC}"
  if nmcli connection down "$active"; then
    echo -e "${GREEN}Disconnected from $active.${NC}"
  else
    echo -e "${RED}Failed to disconnect from $active.${NC}"
  fi
}

delete_saved() {
  local target confirm
  choose_saved_connection "Select a connection to delete" || return $?
  target="$CHOSEN"
  echo ""
  read_input "Are you sure you want to delete '$target'? [y/N, q=back]: " || return 2
  confirm="$REPLY"
  if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
    echo -e "${YELLOW}Cancelled.${NC}"
    return 0
  fi

  if nmcli connection delete "$target"; then
    echo -e "${GREEN}Connection '$target' deleted.${NC}"
  else
    echo -e "${RED}Failed to delete '$target'.${NC}"
  fi
}

show_status

while true; do
  echo ""
  echo "  1) Connect to a new network"
  echo "  2) Reconnect to a saved network"
  echo "  3) Disconnect current network"
  echo "  4) Delete a saved connection"
  echo "  5) Change MAC type of a saved network"
  echo "  6) Edit a saved network (password, user, autoconnect)"
  echo ""
  read_input "Choose an option [1/2/3/4/5/6, q=quit]: " || exit 0
  case "$REPLY" in
    1) connect_new ;;
    2) reconnect_saved ;;
    3) disconnect_current ;;
    4) delete_saved ;;
    5) change_mac_saved ;;
    6) edit_saved ;;
    *) invalid; continue ;;
  esac
  rc=$?
  if [[ $rc -eq 2 ]]; then
    echo ""
    show_status
    continue
  fi
  exit 0
done
