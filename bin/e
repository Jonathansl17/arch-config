#!/usr/bin/env bash
# Master PDF Editor launcher: opens PDF(s) in masterpdfeditor4, detached.
# masterpdfeditor4 is the binary shipped by the AUR package masterpdfeditor-free.
set -euo pipefail

if [ "$#" -eq 0 ]; then
    echo "usage: e <file.pdf> [file...]" >&2
    exit 1
fi

for f in "$@"; do
    masterpdfeditor4 "$f" &
done
