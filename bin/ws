#!/bin/bash
GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; NC='\033[0m'

# Single nmcli + bash loop instead of two separate calls piped through awk.
# Halves the fork count (was: nmcli|awk + nmcli|awk → now: nmcli only).
eth=""; wifi=""
while IFS=: read -r name type; do
    case "$type" in
        *ethernet*) [[ -z "$eth"  ]] && eth="$name"  ;;
        *wireless*) [[ -z "$wifi" ]] && wifi="$name" ;;
    esac
done < <(nmcli -t -f NAME,TYPE connection show --active)

echo -e "${CYAN}=== Wifi Status ===${NC}"
if [[ -n "$eth" ]]; then echo -e "  LAN:  ${GREEN}Connected${NC} → ${GREEN}$eth${NC}"
else echo -e "  LAN:  ${YELLOW}Disconnected${NC}"; fi
if [[ -n "$wifi" ]]; then echo -e "  WiFi: ${GREEN}Connected${NC} → ${GREEN}$wifi${NC}"
else echo -e "  WiFi: ${YELLOW}Disconnected${NC}"; fi
