#!/usr/bin/env bash
# cloc: count only own code, reported as code, tests, docs and config/data.
# Shadows /usr/bin/cloc. Skips dependency, VCS, cache and build-output dirs of
# every common ecosystem, plus lockfiles, minified bundles and source maps.
# Dir names match at any depth. `bin`, `lib` and `pkg` stay counted on purpose:
# they often hold real sources (~/bin, Go's pkg/, Ruby's lib/).
#
# Plain paths run two passes (source and tests) and print one merged table.
# Any option (anything starting with `-`) falls back to a single exclusion-only
# pass, so cloc's own report flags keep working.
# Usage: cloc [PATH...] | cloc [CLOC_OPTIONS...] PATH...   (raw: command cloc)
set -uo pipefail

CLOC_BIN=/usr/bin/cloc
ANSI_CLEAR_LINE=$'\r\e[K'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=cloc-patterns.sh
source "$SCRIPT_DIR/cloc-patterns.sh"

exclude_dirs_arg() {
    local IFS=,
    printf -- '--exclude-dir=%s' "${EXCLUDE_DIRS[*]}"
}

# count_pass OUT_FILE CLOC_FILTER_ARGS... PATH...
count_pass() {
    local out=$1
    shift
    "$CLOC_BIN" --quiet --csv --fullpath "$(exclude_dirs_arg)" "$@" >"$out"
}

# Redraws cloc's progress messages on a single stderr line, erased at the end.
show_progress() {
    awk -v clear="$ANSI_CLEAR_LINE" 'BEGIN { RS = "[\r\n]+" }
        NF && !/^Wrote / { printf "%s%s", clear, $0 > "/dev/stderr"; fflush("/dev/stderr") }
        END { printf "%s", clear > "/dev/stderr" }'
}

# Same as count_pass, but cloc only reports progress when stdout is a
# terminal, so it runs inside a pseudo-terminal and writes the CSV itself.
count_pass_with_progress() {
    local out=$1
    shift
    [ -t 2 ] || { count_pass "$out" "$@"; return; }
    local cmd
    cmd=$(printf '%q ' "$CLOC_BIN" --csv --fullpath --report-file="$out" "$(exclude_dirs_arg)" "$@")
    script -qefc "$cmd" /dev/null </dev/null | show_progress
    return "${PIPESTATUS[0]}"
}

# Prints "category language files blank comment code" rows from a cloc CSV,
# skipping header and SUM rows. Doc and data languages override the pass
# category, so a README inside tests/ counts as docs, not as tests. Languages
# in LANG_RENAMES are shown under their new name.
csv_rows() {
    local csv=$1 category=$2
    awk -F, -v category="$category" -v docs="$DOC_LANGS" -v data="$DATA_LANGS" \
        -v doc_cat="$CATEGORY_DOCS" -v data_cat="$CATEGORY_DATA" -v renames="$LANG_RENAMES" '
        BEGIN { split(docs, d, "|"); for (i in d) is_doc[d[i]] = 1
                split(data, k, "|"); for (i in k) is_data[k[i]] = 1
                split(renames, r, "|"); for (i in r) { split(r[i], p, "="); rename[p[1]] = p[2] } }
        $1 ~ /^[0-9]+$/ && $2 != "SUM" {
            if ($2 in rename) $2 = rename[$2]
            c = category
            if ($2 in is_doc) c = doc_cat
            else if ($2 in is_data) c = data_cat
            printf "%s\t%s\t%s\t%s\t%s\t%s\n", c, $2, $1, $3, $4, $5
        }' "$csv"
}

# Merges rows of the same category and language, then orders them by
# category and by code lines, largest first.
merge_rows() {
    awk -F'\t' '
        { key = $1 FS $2; for (i = 3; i <= 6; i++) sum[key, i] += $i; keys[key] = 1 }
        END { for (key in keys) printf "%s\t%d\t%d\t%d\t%d\n", key,
                  sum[key, 3], sum[key, 4], sum[key, 5], sum[key, 6] }' |
        sort -t$'\t' -k1,1n -k6,6nr
}

print_table() {
    awk -F'\t' -v labels="$CATEGORY_LABELS" '
        function rule() { print "-------------------------------------------------------------------------------" }
        function row(l, f, b, c, k) { printf "%-28s %8s %13s %13s %13s\n", l, f, b, c, k }
        BEGIN { split(labels, label, "|"); rule(); row("Language", "files", "blank", "comment", "code") }
        $1 != current { rule(); print label[$1]; current = $1; seen[$1] = 1 }
        { row("  " $2, $3, $4, $5, $6); for (i = 3; i <= 6; i++) { t[$1, i] += $i; all[i] += $i } }
        END {
            rule()
            for (c = 1; c in label; c++) if (c in seen) row(label[c], t[c, 3], t[c, 4], t[c, 5], t[c, 6])
            row("SUM:", all[3] + 0, all[4] + 0, all[5] + 0, all[6] + 0)
            rule()
        }'
}

render() {
    local src_csv=$1 test_csv=$2
    { csv_rows "$src_csv" "$CATEGORY_CODE"; csv_rows "$test_csv" "$CATEGORY_TESTS"; } |
        merge_rows | print_table
}

# Removes the temp CSVs and stops any pass still running, on every exit path.
cleanup() {
    local pids
    pids=$(jobs -p)
    [ -n "$pids" ] && kill $pids 2>/dev/null
    [ -n "${TMP_DIR:-}" ] && rm -rf "$TMP_DIR"
}

split_count() {
    local src_status test_status
    TMP_DIR=$(mktemp -d) || { echo "cloc: cannot create temp dir" >&2; return 1; }
    count_pass "$TMP_DIR/test" --not-match-f="$EXCLUDE_FILES" --match-f="$TEST_FILES" "$@" &
    local test_pid=$!
    count_pass_with_progress "$TMP_DIR/src" --not-match-f="$EXCLUDE_FILES|$TEST_FILES" "$@"
    src_status=$?
    wait "$test_pid"
    test_status=$?
    if [ "$src_status" -ne 0 ] || [ "$test_status" -ne 0 ]; then
        echo "cloc: count failed (source=$src_status tests=$test_status)" >&2
        return 1
    fi
    render "$TMP_DIR/src" "$TMP_DIR/test"
}

require_paths() {
    local path
    for path in "$@"; do
        [ -e "$path" ] || { echo "cloc: no such file or directory: $path" >&2; return 1; }
    done
}

has_option() {
    local arg
    for arg in "$@"; do
        [[ $arg == -* ]] && return 0
    done
    return 1
}

[ -x "$CLOC_BIN" ] || { echo "cloc: $CLOC_BIN not found (pacman -S cloc)" >&2; exit 1; }

if has_option "$@"; then
    exec "$CLOC_BIN" --fullpath "$(exclude_dirs_arg)" --not-match-f="$EXCLUDE_FILES" "$@"
fi
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
set -- "${@:-.}"
require_paths "$@" || exit 1
split_count "$@"
