#!/usr/bin/env bash
# cloc: count only own code, with test code reported apart from source.
# Shadows /usr/bin/cloc. Skips dependency, VCS, cache and build-output dirs of
# every common ecosystem, plus lockfiles, minified bundles and source maps.
# Dir names match at any depth. `bin`, `lib` and `pkg` stay counted on purpose:
# they often hold real sources (~/bin, Go's pkg/, Ruby's lib/).
#
# Plain paths run two passes (source and tests) and print one merged table.
# Any option (anything starting with `-`) falls back to a single exclusion-only
# pass, so cloc's own report flags keep working.
# Usage: cloc [PATH...] | cloc [CLOC_OPTIONS...] PATH...   (raw: command cloc)
set -uo pipefail

CLOC_BIN=/usr/bin/cloc
TEST_SUFFIX=" (tests)"

EXCLUDE_DIRS=(
    .git .svn .hg .idea .direnv .cache
    node_modules bower_components jspm_packages .pnpm-store .yarn
    .next .next-e2e .nuxt .output .svelte-kit .astro .angular .expo .vite
    .turbo .parcel-cache .docusaurus .vercel .netlify .serverless storybook-static
    dist build out coverage .nyc_output playwright-report test-results
    playwright-artifacts playwright-screenshots
    .venv venv __pycache__ .pytest_cache .mypy_cache .ruff_cache .tox .nox
    .eggs site-packages .ipynb_checkpoints htmlcov
    target .gradle .m2 .mvn .kotlin
    vendor
    obj packages
    .bundle .dart_tool .pub-cache Pods DerivedData Carthage
    _build deps .elixir_ls .stack-work dist-newstyle .terraform
    CMakeFiles cmake-build-debug cmake-build-release .ccls-cache .zig-cache zig-out
)

# Matched against the full path (--fullpath), hence the (^|/) anchors.
EXCLUDE_FILES='(^|/)(package-lock\.json|npm-shrinkwrap\.json|pnpm-lock\.yaml|yarn\.lock|bun\.lockb?|deno\.lock|Cargo\.lock|poetry\.lock|Pipfile\.lock|uv\.lock|pdm\.lock|composer\.lock|Gemfile\.lock|mix\.lock|pubspec\.lock|Podfile\.lock|go\.sum|gradle\.lockfile|packages\.lock\.json|flake\.lock|next-env\.d\.ts|[^/]*\.tsbuildinfo|[^/]*\.min\.(js|css)|[^/]*\.map)$'

# Test code: conventional test dirs, Jest/Vitest/Mocha/Playwright/Cypress
# (*.test.*, *.spec.*, *.cy.*, *.e2e.*), pytest (test_*.py, *_test.py,
# conftest.py), Go/Dart/Elixir (*_test.*), RSpec (*_spec.*), JUnit, Kotest,
# NUnit, xUnit, PHPUnit, XCTest (*Test, *Tests, *Spec, *IT), and the config or
# setup files of those runners.
TEST_FILES='(^|/)(__tests__|__mocks__|tests?|specs?|e2e|cypress|androidTest)/|\.(test|spec|cy|e2e)\.[^/.]+$|(^|/)(test_[^/]*\.py|conftest\.py)$|_(test|spec)\.[^/.]+$|(Test|Tests|Spec|IT|TestCase)\.(java|kt|kts|scala|groovy|cs|fs|vb|php|swift|m|mm)$|(^|/)(jest|vitest|playwright|cypress|karma)\.(config|setup)[^/]*$|(^|/)setupTests\.[^/]+$'

exclude_dirs_arg() {
    local IFS=,
    printf -- '--exclude-dir=%s' "${EXCLUDE_DIRS[*]}"
}

# count_pass OUT_FILE CLOC_FILTER_ARGS... -- PATH...
count_pass() {
    local out=$1
    shift
    "$CLOC_BIN" --quiet --csv --fullpath "$(exclude_dirs_arg)" "$@" >"$out"
}

# Prints "label files blank comment code" rows from a cloc CSV, skipping the
# header and SUM rows; SUFFIX is appended to every language name.
csv_rows() {
    local csv=$1 suffix=$2
    awk -F, -v suffix="$suffix" '
        $1 ~ /^[0-9]+$/ && $2 != "SUM" {
            printf "%s%s\t%s\t%s\t%s\t%s\n", $2, suffix, $1, $3, $4, $5
        }' "$csv" | sort -t$'\t' -k5,5nr
}

render() {
    local src_csv=$1 test_csv=$2
    { csv_rows "$src_csv" ""; printf 'BREAK\n'; csv_rows "$test_csv" "$TEST_SUFFIX"; } |
        awk -F'\t' '
            function rule() { print "-------------------------------------------------------------------------------" }
            function row(l, f, b, c, k) { printf "%-28s %8s %13s %13s %13s\n", l, f, b, c, k }
            function add(t, i) { for (i = 2; i <= 5; i++) t[i] += $i }
            BEGIN { rule(); row("Language", "files", "blank", "comment", "code"); rule() }
            $1 == "BREAK" { tests = 1; if (n) rule(); next }
            { row($1, $2, $3, $4, $5); n++; if (tests) add(t); else add(s) }
            END {
                rule()
                row("Source", s[2] + 0, s[3] + 0, s[4] + 0, s[5] + 0)
                row("Tests", t[2] + 0, t[3] + 0, t[4] + 0, t[5] + 0)
                row("SUM:", s[2] + t[2], s[3] + t[3], s[4] + t[4], s[5] + t[5])
                rule()
            }'
}

split_count() {
    local tmp src_status test_status
    tmp=$(mktemp -d) || { echo "cloc: cannot create temp dir" >&2; return 1; }
    trap 'rm -rf "$tmp"' RETURN
    count_pass "$tmp/src" --not-match-f="$EXCLUDE_FILES|$TEST_FILES" "$@" &
    local src_pid=$!
    count_pass "$tmp/test" --not-match-f="$EXCLUDE_FILES" --match-f="$TEST_FILES" "$@"
    test_status=$?
    wait "$src_pid"
    src_status=$?
    if [ "$src_status" -ne 0 ] || [ "$test_status" -ne 0 ]; then
        echo "cloc: count failed (source=$src_status tests=$test_status)" >&2
        return 1
    fi
    render "$tmp/src" "$tmp/test"
}

has_option() {
    local arg
    for arg in "$@"; do
        [[ $arg == -* ]] && return 0
    done
    return 1
}

[ -x "$CLOC_BIN" ] || { echo "cloc: $CLOC_BIN not found (pacman -S cloc)" >&2; exit 1; }

if has_option "$@"; then
    exec "$CLOC_BIN" --fullpath "$(exclude_dirs_arg)" --not-match-f="$EXCLUDE_FILES" "$@"
fi
split_count "${@:-.}"
