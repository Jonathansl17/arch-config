#!/bin/bash
# Launch alacritty inheriting cwd from the focused Alacritty window.
# Falls back to $HOME if the focused window is not Alacritty or cwd cannot be read.

cwd="$HOME"

# Single xdotool invocation: chain getactivewindow → getwindowclassname →
# getwindowpid. Output is two lines (class, then pid). Replaces three separate
# calls (xdotool + xprop + xdotool) with one fork.
{ read -r wm_class; read -r pid; } < <(xdotool getactivewindow getwindowclassname getwindowpid 2>/dev/null)

if [[ -n "$pid" && "$wm_class" =~ ^(Alacritty|split_term)$ ]]; then
    # First direct child of the terminal — the running shell or tmux client.
    read -r child < <(pgrep -P "$pid")
    target_pid="${child:-$pid}"
    # If the child is a tmux client, ask the server for the active pane's pid.
    if [[ -n "$child" && "$(ps -p "$child" -o comm= 2>/dev/null)" == tmux* ]]; then
        pane_pid=$(tmux list-clients -F '#{client_pid} #{pane_pid}' 2>/dev/null | awk -v c="$child" '$1==c{print $2; exit}')
        [[ -n "$pane_pid" ]] && target_pid="$pane_pid"
    fi
    target_cwd=$(readlink "/proc/$target_pid/cwd" 2>/dev/null)
    [[ -n "$target_cwd" && -d "$target_cwd" ]] && cwd="$target_cwd"
fi

exec alacritty --working-directory "$cwd" "$@"
