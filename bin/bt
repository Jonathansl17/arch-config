#!/bin/bash

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

# Classic (BR/EDR) inquiry needs ~10s; LE advertising shows up in a couple.
# Some controllers starve classic inquiry under the "auto" transport, so we
# scan each transport explicitly instead of a single `scan on`.
SCAN_BREDR_SECS=8
SCAN_LE_SECS=2

# Match a Bluetooth MAC (AA:BB:CC:DD:EE:FF) to drop noise lines from output.
MAC_RE='^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$'

if ! command -v bluetoothctl >/dev/null 2>&1; then
  echo -e "${RED}bluetoothctl not found. Install bluez-utils.${NC}"
  exit 1
fi

# bluetoothctl blocks forever when bluetoothd is down, so probe with a timeout
# and bail with a clear message instead of hanging.
if ! timeout 5 bluetoothctl show >/dev/null 2>&1; then
  echo -e "${RED}Bluetooth daemon not responding.${NC}"
  echo -e "${YELLOW}Start it with: sudo systemctl start bluetooth.service${NC}"
  exit 1
fi

# Detect a Bluetooth controller (avoids acting on a machine without one).
if ! timeout 5 bluetoothctl list 2>/dev/null | grep -q .; then
  echo -e "${RED}No Bluetooth controller detected on this machine.${NC}"
  exit 1
fi

# read_input "prompt" [silent]
# REPLY=text. Returns 2 if user typed q/Q (back).
read_input() {
  local prompt="$1" silent="$2"
  if [[ -n "$silent" ]]; then
    read -rsp "$prompt" REPLY
    echo ""
  else
    read -rp "$prompt" REPLY
  fi
  [[ "$REPLY" == "q" || "$REPLY" == "Q" ]] && return 2
  return 0
}

invalid() { echo -e "${RED}Invalid selection. Try again (q to go back).${NC}"; }

# Power the controller on if it is off (idempotent).
ensure_powered() {
  if ! bluetoothctl show 2>/dev/null | grep -q "Powered: yes"; then
    echo -e "${YELLOW}Powering on Bluetooth controller...${NC}"
    bluetoothctl power on >/dev/null 2>&1
  fi
}

# Echo "MAC<TAB>Name" for each currently connected device.
connected_devices() {
  local mac name
  while read -r _ mac name; do
    [[ "$mac" =~ $MAC_RE ]] || continue
    if bluetoothctl info "$mac" 2>/dev/null | grep -q "Connected: yes"; then
      printf '%s\t%s\n' "$mac" "$name"
    fi
  done < <(bluetoothctl devices Paired 2>/dev/null)
}

show_status() {
  local powered conn
  echo -e "${CYAN}=== Bluetooth Manager ===${NC}"
  echo ""
  if bluetoothctl show 2>/dev/null | grep -q "Powered: yes"; then
    powered="${GREEN}On${NC}"
  else
    powered="${YELLOW}Off${NC}"
  fi
  echo -e "  Power:     $powered"

  conn=$(connected_devices)
  if [[ -n "$conn" ]]; then
    while IFS=$'\t' read -r mac name; do
      echo -e "  Connected: ${GREEN}${name}${NC} (${mac})"
    done <<< "$conn"
  else
    echo -e "  Connected: ${YELLOW}None${NC}"
  fi
}

# Parse "Device MAC Name..." lines into the `devices` array as "MAC<TAB>Name".
scan_connect() {
  local devices=() mac name line net_choice
  ensure_powered
  # Make this PC visible + pairable so phones/2-way devices can find it,
  # and stay visible (timeout 0) for the whole connect flow. Hide again on
  # any exit from this function so the PC isn't left discoverable.
  trap 'bluetoothctl discoverable off >/dev/null 2>&1' RETURN
  bluetoothctl discoverable-timeout 0 >/dev/null 2>&1
  bluetoothctl discoverable on >/dev/null 2>&1
  bluetoothctl pairable on >/dev/null 2>&1
  while true; do
    echo ""
    echo -e "${YELLOW}Scanning for devices ($((SCAN_BREDR_SECS + SCAN_LE_SECS))s)...${NC}"
    bluetoothctl --timeout "$SCAN_BREDR_SECS" scan bredr >/dev/null 2>&1
    bluetoothctl --timeout "$SCAN_LE_SECS" scan le >/dev/null 2>&1

    # Dedup by name: phones rotate random BLE addresses, so one device shows
    # up under several MACs. Keep the first MAC seen per name.
    devices=()
    declare -A seen_name=()
    while read -r _ mac name; do
      [[ "$mac" =~ $MAC_RE ]] || continue
      name="${name:-Unknown}"
      [[ -n "${seen_name[$name]}" ]] && continue
      seen_name["$name"]=1
      devices+=("${mac}"$'\t'"${name}")
    done < <(bluetoothctl devices 2>/dev/null)

    if [[ ${#devices[@]} -eq 0 ]]; then
      echo -e "${RED}No devices found.${NC}"
      return 0
    fi

    echo ""
    echo -e "${CYAN}Available devices:${NC}"
    echo ""
    for i in "${!devices[@]}"; do
      IFS=$'\t' read -r mac name <<< "${devices[$i]}"
      printf "  %d) %-30s %s\n" $((i+1)) "$name" "$mac"
    done

    echo ""
    while true; do
      read_input "Select a device [1-${#devices[@]}, 0=rescan, q=back]: " || return 2
      net_choice="$REPLY"
      if [[ "$net_choice" == "0" ]]; then
        clear
        break
      fi
      if [[ "$net_choice" =~ ^[0-9]+$ ]] && (( net_choice >= 1 && net_choice <= ${#devices[@]} )); then
        break 2
      fi
      invalid
    done
  done

  IFS=$'\t' read -r mac name <<< "${devices[$((net_choice-1))]}"
  echo ""
  echo -e "Selected: ${GREEN}$name${NC} ($mac)"

  if bluetoothctl info "$mac" 2>/dev/null | grep -q "Paired: yes"; then
    # Already paired: trust for auto-reconnect, then just connect.
    echo -e "${YELLOW}Connecting...${NC}"
    bluetoothctl trust "$mac" >/dev/null 2>&1
    bluetoothctl connect "$mac" >/dev/null 2>&1
  else
    echo -e "${YELLOW}Pairing with $name...${NC}"
    pair_interactive "$mac"
  fi

  if bluetoothctl info "$mac" 2>/dev/null | grep -q "Connected: yes"; then
    echo -e "${GREEN}Connected to $name successfully!${NC}"
  elif bluetoothctl info "$mac" 2>/dev/null | grep -q "Paired: yes"; then
    echo -e "${GREEN}Paired with $name.${NC} ${YELLOW}Not connected — normal for phones (no audio profile to hold). Use option 2 to reconnect when needed.${NC}"
  else
    echo -e "${RED}Failed to pair with $name.${NC}"
    echo -e "${YELLOW}Tip: put the device in pairing mode. For a phone, pairing is more reliable when started FROM the phone toward this PC.${NC}"
  fi
}

# Pairing uses Secure Simple Pairing, which is interactive: BlueZ prompts
# "Confirm passkey NNNNNN (yes/no)". Drive bluetoothctl through a coprocess so
# the script auto-answers that prompt and closes the session itself once
# pairing resolves — no manual quit/Ctrl-Z. All bluetoothctl chatter is
# captured and suppressed; the caller reports only paired/connected state.
pair_interactive() {
  local mac="$1" line paired=0

  coproc BTPAIR { bluetoothctl 2>&1; }
  # Keep scanning during the session: stopping discovery makes BlueZ prune the
  # device ("not available"). Re-discover, then pair.
  {
    echo "power on"
    echo "agent on"
    echo "default-agent"
    echo "pairable on"
    echo "scan on"
  } >&"${BTPAIR[1]}"
  sleep 3
  echo "pair $mac" >&"${BTPAIR[1]}"

  # read -t bounds the wait so a silent device can't hang the session forever.
  while IFS= read -t 30 -r line <&"${BTPAIR[0]}"; do
    case "$line" in
      *"Request confirmation"*|*"Confirm passkey"*|*"Authorize service"*|*"Request authorization"*)
        echo "yes" >&"${BTPAIR[1]}" ;;
      *"Pairing successful"*)
        paired=1
        echo "trust $mac" >&"${BTPAIR[1]}"
        echo "connect $mac" >&"${BTPAIR[1]}" ;;
      *"Failed to pair"*|*"not available"*|*"not ready"*|*"AuthenticationFailed"*|*"AuthenticationCanceled"*|*"AuthenticationTimeout"*)
        echo "quit" >&"${BTPAIR[1]}" ;;
    esac
    if [[ $paired -eq 1 ]]; then
      case "$line" in
        *"Connection successful"*|*"Failed to connect"*|*"br-connection"*|*"Disconnected"*)
          echo "quit" >&"${BTPAIR[1]}" ;;
      esac
    fi
  done

  # Guarantee the coprocess ends (covers the read timeout path).
  echo "quit" >&"${BTPAIR[1]}" 2>/dev/null
  wait "$BTPAIR_PID" 2>/dev/null
}

reconnect_paired() {
  local paired=() mac name re_choice chosen_mac chosen_name
  ensure_powered
  echo ""
  echo -e "${YELLOW}Paired devices:${NC}"
  echo ""
  while read -r _ mac name; do
    [[ "$mac" =~ $MAC_RE ]] || continue
    paired+=("${mac}"$'\t'"${name:-Unknown}")
  done < <(bluetoothctl devices Paired 2>/dev/null)

  if [[ ${#paired[@]} -eq 0 ]]; then
    echo -e "${RED}No paired devices found.${NC}"
    return 0
  fi

  for i in "${!paired[@]}"; do
    IFS=$'\t' read -r mac name <<< "${paired[$i]}"
    printf "  %d) %-30s %s\n" $((i+1)) "$name" "$mac"
  done
  echo ""

  while true; do
    read_input "Select a device [1-${#paired[@]}, q=back]: " || return 2
    re_choice="$REPLY"
    if [[ "$re_choice" =~ ^[0-9]+$ ]] && (( re_choice >= 1 && re_choice <= ${#paired[@]} )); then
      break
    fi
    invalid
  done

  IFS=$'\t' read -r chosen_mac chosen_name <<< "${paired[$((re_choice-1))]}"
  echo -e "${YELLOW}Connecting to $chosen_name...${NC}"
  if bluetoothctl connect "$chosen_mac"; then
    echo -e "${GREEN}Connected to $chosen_name successfully!${NC}"
  else
    echo -e "${RED}Failed to connect to $chosen_name.${NC}"
  fi
}

disconnect_current() {
  local conn=() mac name dc_choice chosen_mac chosen_name
  echo ""
  mapfile -t conn < <(connected_devices)

  if [[ ${#conn[@]} -eq 0 ]]; then
    echo -e "${YELLOW}No device currently connected.${NC}"
    return 0
  fi

  echo -e "${YELLOW}Connected devices:${NC}"
  echo ""
  for i in "${!conn[@]}"; do
    IFS=$'\t' read -r mac name <<< "${conn[$i]}"
    printf "  %d) %-30s %s\n" $((i+1)) "$name" "$mac"
  done
  echo ""

  while true; do
    read_input "Select a device to disconnect [1-${#conn[@]}, q=back]: " || return 2
    dc_choice="$REPLY"
    if [[ "$dc_choice" =~ ^[0-9]+$ ]] && (( dc_choice >= 1 && dc_choice <= ${#conn[@]} )); then
      break
    fi
    invalid
  done

  IFS=$'\t' read -r chosen_mac chosen_name <<< "${conn[$((dc_choice-1))]}"
  echo -e "${YELLOW}Disconnecting from $chosen_name...${NC}"
  if bluetoothctl disconnect "$chosen_mac"; then
    echo -e "${GREEN}Disconnected from $chosen_name.${NC}"
  else
    echo -e "${RED}Failed to disconnect from $chosen_name.${NC}"
  fi
}

toggle_power() {
  echo ""
  if bluetoothctl show 2>/dev/null | grep -q "Powered: yes"; then
    echo -e "${YELLOW}Powering off controller...${NC}"
    if bluetoothctl power off >/dev/null 2>&1; then
      echo -e "${GREEN}Bluetooth powered off.${NC}"
    else
      echo -e "${RED}Failed to power off.${NC}"
    fi
  else
    echo -e "${YELLOW}Powering on controller...${NC}"
    if bluetoothctl power on >/dev/null 2>&1; then
      echo -e "${GREEN}Bluetooth powered on.${NC}"
    else
      echo -e "${RED}Failed to power on.${NC}"
    fi
  fi
}

remove_paired() {
  local paired=() mac name del_choice target_mac target_name confirm
  echo ""
  echo -e "${YELLOW}Paired devices:${NC}"
  echo ""
  while read -r _ mac name; do
    [[ "$mac" =~ $MAC_RE ]] || continue
    paired+=("${mac}"$'\t'"${name:-Unknown}")
  done < <(bluetoothctl devices Paired 2>/dev/null)

  if [[ ${#paired[@]} -eq 0 ]]; then
    echo -e "${RED}No paired devices found.${NC}"
    return 0
  fi

  for i in "${!paired[@]}"; do
    IFS=$'\t' read -r mac name <<< "${paired[$i]}"
    printf "  %d) %-30s %s\n" $((i+1)) "$name" "$mac"
  done
  echo ""

  while true; do
    read_input "Select a device to remove [1-${#paired[@]}, q=back]: " || return 2
    del_choice="$REPLY"
    if [[ "$del_choice" =~ ^[0-9]+$ ]] && (( del_choice >= 1 && del_choice <= ${#paired[@]} )); then
      break
    fi
    invalid
  done

  IFS=$'\t' read -r target_mac target_name <<< "${paired[$((del_choice-1))]}"
  echo ""
  read_input "Are you sure you want to remove '$target_name'? [y/N, q=back]: " || return 2
  confirm="$REPLY"
  if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
    echo -e "${YELLOW}Cancelled.${NC}"
    return 0
  fi

  if bluetoothctl remove "$target_mac"; then
    echo -e "${GREEN}Device '$target_name' removed.${NC}"
  else
    echo -e "${RED}Failed to remove '$target_name'.${NC}"
  fi
}

show_status

while true; do
  echo ""
  echo "  1) Scan and connect to a new device"
  echo "  2) Reconnect to a paired device"
  echo "  3) Disconnect a device"
  echo "  4) Remove a paired device"
  echo "  5) Toggle Bluetooth power on/off"
  echo ""
  read_input "Choose an option [1/2/3/4/5, q=quit]: " || exit 0
  case "$REPLY" in
    1) scan_connect ;;
    2) reconnect_paired ;;
    3) disconnect_current ;;
    4) remove_paired ;;
    5) toggle_power ;;
    *) invalid; continue ;;
  esac
  # Always return to the menu after an action (success, failure, or q=back).
  # The only exit is q at this top-level prompt.
  echo ""
  show_status
done
