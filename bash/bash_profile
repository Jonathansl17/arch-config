#
# ~/.bash_profile
#

# Environment lives here (not in ~/.bashrc) so it's set once per login and
# inherited by every child shell — no idempotence guards, no PATH duplication
# when bashrc is re-sourced.
export JAVA_HOME=/usr/lib/jvm/default
export ANDROID_HOME=/opt/android-sdk
export ANDROID_SDK_ROOT=$ANDROID_HOME
export NVM_DIR="$HOME/.nvm"
export PNPM_HOME="$HOME/.local/share/pnpm"
export CHROME_BIN=/usr/bin/brave

# PATH order (left = highest priority): pnpm, ~/bin (termclip), ~/.local/bin,
# ~/go/bin (go install targets), inherited PATH, then Java/Android tooling.
export PATH="$PNPM_HOME:$HOME/bin:$HOME/.local/bin:$HOME/go/bin:$PATH:$JAVA_HOME/bin:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$ANDROID_HOME/build-tools/34.0.0"

[[ -f ~/.bashrc ]] && . ~/.bashrc

# Keep the X auth cookie in the tmpfs runtime dir instead of ~/.Xauthority.
# It is user-owned, wiped on logout, and regenerated each login — so a stray
# root-owned file or stale lock can never wedge X with a "locking timeout".
export XAUTHORITY="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/Xauthority"

if [[ -z $DISPLAY && $XDG_VTNR -eq 1 ]]; then
  # Pre-create the auth file so startx's xauth doesn't warn "does not exist"
  # on first login (tmpfs is wiped on logout, so this runs each session).
  [[ -f $XAUTHORITY ]] || install -m600 /dev/null "$XAUTHORITY"
  exec startx
fi
