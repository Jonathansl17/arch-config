#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias ls='ls --color=auto'
alias la='ls -ldA --color=auto .[!.]* ..?* 2>/dev/null'
alias grep='grep --color=auto'
PS1='[\u@\h \[\033[1;96m\]\W\[\033[0m\]]\$ '
stty intr ^Z
stty susp ^C
alias pgadmin4="setsid -f /usr/pgadmin4/bin/pgadmin4 >/dev/null 2>&1"
alias postman="setsid -f postman >/dev/null 2>&1"
alias idea="setsid -f idea >/dev/null 2>&1"
alias code="setsid -f code >/dev/null 2>&1"
alias brave="setsid -f brave >/dev/null 2>&1"
alias pcmanfm="setsid -f pcmanfm >/dev/null 2>&1"
alias discord="setsid -f discord >/dev/null 2>&1"
alias telegram="setsid -f Telegram >/dev/null 2>&1"
alias obs="setsid -f obs >/dev/null 2>&1"
alias wireshark="setsid -f wireshark >/dev/null 2>&1"
alias jmeter="_JAVA_AWT_WM_NONREPARENTING=1 setsid -f jmeter >/dev/null 2>&1"
alias what="setsid -f /opt/brave-bin/brave --profile-directory=Default --app-id=hnpfjngllnobngcgfapefoaidbinmjnm >/dev/null 2>&1"
alias spot="setsid -f /opt/brave-bin/brave --profile-directory=Default --app-id=pjibgclleladliembfgfagdaldikeohf >/dev/null 2>&1"
alias teams="setsid -f /opt/brave-bin/brave --profile-directory=Default --app-id=cifhbcnohmdccbgoicgdjpfamggdegmo >/dev/null 2>&1"
alias o="sudo systemctl poweroff -i"
alias u='sudo pacman -Syu && yay -Syu'
alias feh='feh -F'
alias cf="claude --dangerously-skip-permissions"

# Typing the full name gets the ~/bin/x behaviour (detached + template).
# No recursion: the script calls /usr/bin/xournalpp by absolute path.
alias xournalpp='x'

# === GUI launcher functions ===
# `x` (Xournal++) lives in ~/bin/x — it needs no shell state.
# `evince` stays a function: it shadows the binary of the same name.
evince() {
    setsid -f /usr/bin/evince "$@" >/dev/null 2>&1
}

# === nvm (Node Version Manager) — lazy load ===
# Stubs load nvm/node/npm/npx/corepack on demand. Saves ~48ms per shell.
# NVM_DIR is exported in ~/.bash_profile.
_nvm_load() {
    unset -f nvm node npm npx corepack
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
}
nvm()      { _nvm_load; nvm "$@"; }
node()     { _nvm_load; node "$@"; }
npm()      { _nvm_load; npm "$@"; }
npx()      { _nvm_load; npx "$@"; }
corepack() { _nvm_load; corepack "$@"; }

# === local overrides (NOT VERSIONED) ===
# ~/.bashrc.local is for aliases/variables with credentials, tokens
# or anything machine-specific that must not travel with the repo.
# If it doesn't exist nothing happens — this block is optional.
[ -f "$HOME/.bashrc.local" ] && . "$HOME/.bashrc.local"

# zoxide (smarter cd: z <dir>, zi <query> selector fzf)
command -v zoxide >/dev/null && eval "$(zoxide init bash)"

# === history ===
HISTCONTROL=ignoreboth:erasedups
HISTSIZE=10000
HISTFILESIZE=20000
shopt -s histappend cmdhist checkwinsize
# === end history ===
alias burpsuite="setsid -f burpsuite >/dev/null 2>&1"

# === alt screen guard ===
# Ctrl-C está mapeado a SIGTSTP (ver stty arriba), así que suspender un TUI
# (nvim, less, htop, claude) lo detiene sin que restaure la pantalla principal.
# La terminal queda en alt screen y, con ALTERNATE_SCROLL activo (default en
# Alacritty 0.17, ya no configurable), la rueda emite \e[A / \e[B: el scroll
# pasa a recorrer el historial de comandos en vez del scrollback.
# Salir del alt screen en cada prompt lo corrige. Es no-op si ya estamos en la
# pantalla principal, y los TUIs reentran solos al hacer `fg`.
#
# Va aquí y no en ~/.bash_profile: PROMPT_COMMAND es por-shell y bash no
# exporta arrays, así que un bash anidado perdería el hook si se heredara.
ANSI_EXIT_ALT_SCREEN=$'\e[?1049l'
_exit_alt_screen() { printf '%s' "$ANSI_EXIT_ALT_SCREEN"; }
# Guarda de idempotencia: `source ~/.bashrc` no debe duplicar el hook.
case ";$PROMPT_COMMAND;" in
    *";_exit_alt_screen;"*) ;;
    *) PROMPT_COMMAND="_exit_alt_screen${PROMPT_COMMAND:+; $PROMPT_COMMAND}" ;;
esac
# === end alt screen guard ===
