" IdeaVim config — mirrors ~/.config/nvim/init.lua used by vscode-neovim.
" Docs: https://github.com/JetBrains/ideavim

let mapleader = " "
let maplocalleader = " "

set number
set ignorecase
set smartcase
set scrolloff=8
set nowrap
set virtualedit=onemore
set clipboard+=unnamedplus
" Mouse selections enter Select mode (typing replaces the text, like a plain
" editor) instead of Visual, so insert mode is kept after selecting with the mouse.
" ideaselection does the same for IDE-made selections, e.g. the one Ctrl+Z restores.
set selectmode=mouse,ideaselection

" IdeaVim extensions
set surround
set commentary
set highlightedyank

" --- Leader mappings ---

" File tree / navigation
nnoremap <leader>o :action ActivateProjectToolWindow<CR>
nnoremap <leader>F :action SelectInProjectView<CR>
" alt+e: editor -> Project tree. From the tree, the keymap binds alt+e to
" FocusEditor, so it returns to the editor without hiding the tree.
sethandler <A-e> a:vim
nnoremap <A-e> :action ActivateProjectToolWindow<CR>
vnoremap <A-e> <Esc>:action ActivateProjectToolWindow<CR>
" <Action>() runs without leaving insert mode, so insert survives the round trip.
imap <A-e> <Action>(ActivateProjectToolWindow)
nnoremap <Tab> :action NextTab<CR>
nnoremap <S-Tab> :action PreviousTab<CR>

" Search
nnoremap <leader>f :action GotoFile<CR>
nnoremap <leader>/ :action FindInPath<CR>

" Refactor / diagnostics
nnoremap <leader>n :action RenameElement<CR>
nnoremap <leader>ca :action ShowIntentionActions<CR>
vnoremap <leader>ca :action ShowIntentionActions<CR>

" LSP-like navigation
nnoremap gd :action GotoDeclaration<CR>
nnoremap gr :action FindUsages<CR>
nnoremap gi :action GotoImplementation<CR>
nnoremap K :action QuickJavaDoc<CR>
nnoremap [d :action GotoPreviousError<CR>
nnoremap ]d :action GotoNextError<CR>
